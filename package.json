{
  "name": "yoga-planner",
  "private": true,
  "version": "0.1.0",
  "description": "Planeamento e desenho de aulas de Hatha Yoga para instrutores",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "dev:lan": "vite --host",
    "icons": "node scripts/generate-icons.mjs",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview:pages": "vite preview --mode pages --port 4173"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^2.0.0"
  }
}
